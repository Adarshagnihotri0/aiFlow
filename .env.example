# AWS credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token   # only needed for temporary credentials

# AWS region where Bedrock is enabled
AWS_REGION=ap-south-1

# Port this proxy listens on
PORT=3000

# Optional fixed LAN clipboard token (16+ characters).
# When omitted, a token is generated at ~/.copilot/lan-clipboard/token.
LAN_CLIPBOARD_TOKEN=replace_with_a_long_random_token

# PostgreSQL connection (for execution trace persistence)`
DATABASE_URL="postgresql://your_username@localhost:5432/your_database_name"

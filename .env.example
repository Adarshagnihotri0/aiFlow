# AWS credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token   # only needed for temporary credentials

# AWS region where Bedrock is enabled
AWS_REGION=ap-south-1

# Port this proxy listens on
PORT=3000

# PostgreSQL connection (for execution trace persistence)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/future_db?schema=public"

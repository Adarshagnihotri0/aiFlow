{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Dev Server with Notification",
      "type": "shell",
      "command": "npm run dev && afplay /System/Library/Sounds/Hero.aiff || afplay /System/Library/Sounds/Basso.aiff",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Build with Notification",
      "type": "shell",
      "command": "npm run build && osascript -e 'display notification \"Build completed successfully\" with title \"Bedrock Proxy\" sound name \"Glass\"' || osascript -e 'display notification \"Build failed\" with title \"Bedrock Proxy\" sound name \"Basso\"'",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Run Agent with Notification",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "shell": {
          "executable": "bash",
          "args": ["-c"]
        }
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "default"
      }
    }
  ]
}